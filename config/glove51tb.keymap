#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <behaviors/rgbled_widget.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// Layer Numbering

#define DEFAULT 0
#define NUM     1
#define SYM     2
#define FUN     3
#define MOUSE   4
#define SCROLL  5

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        dublle {
            if-layers = <2 1>;
            then-layer = <3>;
        };
    };
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        scroll {
            bindings = <&mo 5>;
            key-positions = <35 36>;
        };
    };

    behaviors {
        sensor_rotate_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_wheel_scroll: mouse_wheel_scroll {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    macros {
        new_macro: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>;
            label = "NEW_MACRO";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "DEFAULT";
            bindings = <
&none  &kp Q             &kp W             &kp E         &kp R                        &kp T                                                           &kp Y        &kp U  &kp I      &kp O         &kp P                      &none
&none  &kp A             &kp S             &kp D         &kp F                        &kp G        &trans                        &kp LS(LG(A))        &kp H        &kp J  &kp K      &kp L         &kp SINGLE_QUOTE           &none
&none  &mt LEFT_SHIFT Z  &kp X             &kp C         &kp V                        &kp B        &mt LEFT_SHIFT TAB            &mt RIGHT_SHIFT TAB  &kp N        &kp M  &kp COMMA  &lt 5 PERIOD  &mt RIGHT_SHIFT SEMICOLON  &none
&none  &lt 6 ESC         &kp LEFT_CONTROL  &kp LEFT_ALT  &mt LEFT_COMMAND LANGUAGE_2  &lt 1 SPACE  &mt RIGHT_COMMAND LANGUAGE_1  &kp BACKSPACE        &lt 2 ENTER                                  &kp SLASH                  &none
            >;

            sensor-bindings = <&mouse_wheel_scroll SCRL_UP SCRL_DOWN>;
        };

        number_layer {
            label = "NUM";
            bindings = <
&trans  &kp F1   &kp F2   &kp F3   &kp F4   &kp F5                   &kp EQUAL     &kp MINUS     &kp PLUS      &kp ASTERISK  &kp SLASH     &trans
&trans  &kp F6   &kp F7   &kp F8   &kp F9   &kp F10  &trans  &trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5        &trans
&trans  &kp F11  &kp F12  &kp F13  &kp F14  &kp F15  &trans  &trans  &kp NUMBER_6  &kp N7        &kp N8        &kp N9        &kp NUMBER_0  &trans
&trans  &trans   &trans   &trans   &trans   &trans   &trans  &trans  &trans                                                  &trans        &trans
            >;

            sensor-bindings = <&inc_dec_kp 0 0>;
        };

        symbal_layer {
            label = "FUN";
            bindings = <
&trans  &kp EXCLAMATION  &kp QUESTION   &kp AMPERSAND         &kp PIPE          &kp BACKSLASH                   &kp EQUAL        &kp MINUS          &kp PLUS               &kp ASTERISK      &kp SLASH      &trans
&trans  &kp CARET        &kp TILDE      &kp GRAVE             &kp DOLLAR        &kp HASH        &trans  &trans  &kp PERCENT      &kp LEFT           &kp RIGHT              &kp UP            &kp DOWN       &trans
&trans  &kp AT_SIGN      &kp LESS_THAN  &kp LEFT_PARENTHESIS  &kp LEFT_BRACKET  &kp LEFT_BRACE  &trans  &trans  &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &kp RIGHT_PARENTHESIS  &kp GREATER_THAN  &kp SEMICOLON  &trans
&trans  &trans           &trans         &trans                &trans            &trans          &trans  &trans  &trans                                                                       &trans         &trans
            >;

            sensor-bindings = <&sensor_rotate_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        move_controller_layer {
            bindings = <
&trans  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &kp C_PREVIOUS        &kp C_PAUSE           &kp C_NEXT                        &kp C_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp LG(MINUS)  &kp LG(EQUAL)  &trans
&trans  &kp LG(LA(F))         &kp LG(LEFT_CONTROL)  &kp LG(LS(LEFT_ALT))  &kp LG(LC(LEFT_ALT))  &kp LG(LEFT_ALT)  &trans  &trans  &trans      &kp LEFT           &kp RIGHT        &kp UP         &kp DOWN       &trans
&trans  &kp LEFT_SHIFT        &trans                &trans                &trans                &trans            &trans  &trans  &trans      &kp LC(LEFT)       &kp LC(RIGHT)    &kp LC(UP)     &trans         &trans
&trans  &trans                &trans                &trans                &trans                &trans            &trans  &trans  &trans                                                         &trans         &trans
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &mkp MCLK  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp LCLK  &mkp RCLK  &mo 5   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                                &trans  &trans
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&trans  &trans                    &trans                     &trans                &trans                 &trans                  &trans  &trans     &trans     &trans  &trans  &trans
&trans  &kp LG(LS(LEFT_BRACKET))  &kp LG(LS(RIGHT_BRACKET))  &kp LG(LEFT_BRACKET)  &kp LG(RIGHT_BRACKET)  &trans  &trans  &trans  &trans  &trans     &mkp MCLK  &trans  &trans  &trans
&trans  &trans                    &trans                     &trans                &trans                 &trans  &trans  &trans  &trans  &mkp LCLK  &mkp RCLK  &trans  &trans  &trans
&trans  &trans                    &trans                     &trans                &trans                 &trans  &trans  &trans  &trans                                &trans  &trans
            >;
        };

        bluetooth {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans        &trans        &trans        &trans      &trans          &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_CLR  &bt BT_CLR_ALL  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans      &trans          &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                                                &trans          &trans
            >;
        };
    };
};
