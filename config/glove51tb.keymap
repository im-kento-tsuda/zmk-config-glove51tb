#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <behaviors/rgbled_widget.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// Layer Numbering

#define DEFAULT 0
#define NUM     1
#define SYM     2
#define FUN     3
#define MOUSE   4
#define SCROLL  5

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        scroll {
            bindings = <&mo 5>;
            key-positions = <35 36>;
        };
    };

    behaviors {
        sensor_rotate_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_wheel_scroll: mouse_wheel_scroll {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    macros {
        new_macro: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>;
            label = "NEW_MACRO";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "DEFAULT";
            bindings = <
&none  &kp Q    &kp W             &kp E         &kp R        &kp T                                                                   &kp Y        &kp U  &kp I      &kp O         &kp P             &none
&none  &kp A    &kp S             &kp D         &kp F        &kp G        &kp BACKSPACE                &kp DELETE                    &kp H        &kp J  &kp K      &kp L         &kp SINGLE_QUOTE  &none
&none  &kp Z    &kp X             &kp C         &kp V        &kp B        &mt LEFT_SHIFT TAB           &mt RIGHT_SHIFT TAB           &kp N        &kp M  &kp COMMA  &lt 5 PERIOD  &kp SEMICOLON     &none
&none  &kp ESC  &kp LEFT_CONTROL  &kp LEFT_ALT  &lt 3 SPACE  &lt 1 SPACE  &mt LEFT_COMMAND LANGUAGE_2  &mt RIGHT_COMMAND LANGUAGE_1  &lt 2 ENTER                                  &kp SLASH         &none
            >;

            sensor-bindings = <&mouse_wheel_scroll SCRL_UP SCRL_DOWN>;
        };

        number_layer {
            label = "NUM";
            bindings = <
&trans  &kp F1   &kp F2   &kp F3   &kp F4   &kp F5                   &kp EQUAL     &kp PLUS      &kp MINUS     &kp ASTERISK  &kp SLASH     &trans
&trans  &kp F6   &kp F7   &kp F8   &kp F9   &kp F10  &trans  &trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5        &trans
&trans  &kp F11  &kp F12  &kp F13  &kp F14  &kp F15  &trans  &trans  &kp NUMBER_6  &kp N7        &kp N8        &kp N9        &kp NUMBER_0  &trans
&trans  &trans   &trans   &trans   &trans   &trans   &trans  &trans  &trans                                                  &trans        &trans
            >;

            sensor-bindings = <&inc_dec_kp 0 0>;
        };

        symbal_layer {
            label = "FUN";
            bindings = <
&trans  &kp EXCLAMATION  &kp QUESTION   &kp AMPERSAND     &kp PIPE              &kp BACKSLASH                          &kp EQUAL         &kp PLUS           &kp MINUS       &kp ASTERISK     &kp SLASH          &trans
&trans  &kp CARET        &kp TILDE      &kp GRAVE         &kp HASH              &kp DOLLAR             &trans  &trans  &kp COLON         &kp SEMICOLON      &kp COMMA       &kp PERIOD       &kp SQT            &trans
&trans  &kp AT_SIGN      &kp LESS_THAN  &kp GREATER_THAN  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans  &trans  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp DOUBLE_QUOTES  &trans
&trans  &trans           &trans         &trans            &trans                &trans                 &trans  &trans  &trans                                                                &trans             &trans
            >;

            sensor-bindings = <&sensor_rotate_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        move_controller_layer {
            bindings = <
&trans  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &kp C_PREVIOUS  &kp C_PAUSE  &kp C_NEXT                      &kp C_MUTE  &kp C_VOLUME_UP  &kp C_VOLUME_UP  &kp LG(MINUS)  &kp LG(EQUAL)  &trans
&trans  &bt BT_SEL 0          &bt BT_SEL 1          &bt BT_SEL 2    &bt BT_CLR   &bt BT_CLR_ALL  &trans  &trans  &trans      &kp LEFT         &kp RIGHT        &kp UP         &kp DOWN       &trans
&trans  &trans                &trans                &trans          &trans       &trans          &trans  &trans  &trans      &trans           &trans           &trans         &trans         &trans
&trans  &trans                &trans                &trans          &trans       &trans          &trans  &trans  &trans                                                       &trans         &trans
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&trans  &none                     &none                      &none                 &none                  &none                   &none   &none      &none      &none  &none  &trans
&trans  &msc SCRL_LEFT            &msc SCRL_RIGHT            &msc SCRL_UP          &msc SCRL_DOWN         &none   &trans  &trans  &none   &none      &mkp MCLK  &none  &none  &trans
&trans  &kp LG(LS(LEFT_BRACKET))  &kp LG(LS(RIGHT_BRACKET))  &kp LG(LEFT_BRACKET)  &kp LG(RIGHT_BRACKET)  &none   &none   &none   &none   &mkp LCLK  &mkp RCLK  &mo 5  &none  &trans
&trans  &trans                    &trans                     &trans                &trans                 &trans  &trans  &trans  &trans                               &none  &trans
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&trans  &trans                    &trans                     &trans                &trans                 &trans                  &trans  &trans     &trans     &trans  &trans  &trans
&trans  &msc SCRL_LEFT            &msc SCRL_RIGHT            &msc SCRL_UP          &msc SCRL_DOWN         &trans  &trans  &trans  &trans  &trans     &mkp MCLK  &trans  &trans  &trans
&trans  &kp LG(LS(LEFT_BRACKET))  &kp LG(LS(RIGHT_BRACKET))  &kp LG(LEFT_BRACKET)  &kp LG(RIGHT_BRACKET)  &trans  &trans  &trans  &trans  &mkp LCLK  &mkp RCLK  &trans  &trans  &trans
&trans  &trans                    &trans                     &trans                &trans                 &trans  &trans  &trans  &trans                                &trans  &trans
            >;
        };
    };
};
